{
 "schema": "launch_glassies_v1/1 (glassy_revamp_v3/1 plus `follows` and the `drip` idle type)",
 "coordinates": "Roblox model space: roblox = (x, z, -y) of Blender; studs at GlassyScale 1; origin = hang point",
 "idle_types": {
  "sway": "rotate about axis amp_deg*sin(2*pi*t/period_s+phase)",
  "spin": "rotate about axis at deg_per_s",
  "bob": "translate along axis amp_studs*sin(...)",
  "pulse": "scale about pivot 1+amp*sin(...); Neon parts also brighten",
  "slosh": "rotate about axis by -gain*swing angular velocity (deg/s), clamp max_deg, spring freq_hz/damping",
  "flicker": "random scale jitter amp at rate_hz",
  "blink": "scale along axis to 0.1 for dur_s every interval_s (+-40%)",
  "drip": "loop every period_s: scale 0->1 over grow_s at the pivot, then slide fall_studs along the axis while fading, reset",
  "static": "no idle motion"
 },
 "hit_types": {
  "kick": "rotate deg about axis (sign from hit side), spring back",
  "flare": "rotate deg outward, spring back",
  "hop": "translate studs along axis, spring back",
  "squash": "scale factor along axis, spring back",
  "flash": "Neon/brighten for dur_s",
  "spin_boost": "add deg_per_s decaying over dur_s",
  "none": "no reaction"
 },
 "follows": "A part with `follows` rides the named part: apply the parent's motion first, then its own idle/hit in the parent's frame (fish tail on the fish, eye shine on the eyes, chips on their cookie). Parts with the same motion as the parent repeat it.",
 "body_motion": "Glass Top's Body has a cosmetic spin about the hang axis; its stripes, ring, knob and tip follow it.",
