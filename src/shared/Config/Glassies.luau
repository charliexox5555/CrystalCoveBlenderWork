--!strict
-- Every glassy in the game (GAME_DESIGN 4). Adding a glassy = one entry here + one asset folder
-- under assets/blender/glassies/<Id>/. No new code.
--
-- Base stats are before rarity and stars (see Formula.stats). Type leans:
--   Heavy  ~ Power 20, HP 112, Swing 6   (heavy and steady: wins pushing contests)
--   Fizzy  ~ Power 20, HP 110, Swing 10  (balanced)
--   Sharp  ~ Power 21, HP 105, Swing 14  (swings high, crits more, cracks a bit sooner)
-- Fight strength is roughly Power x HP, so keep that product about equal across types.
--
-- Fields:
--   Passive / Special      power ids from Config/Powers (PassiveName / SpecialName rename them)
--   Radius                 collision radius in studs at the glass's widest point (fight sim)
--   Mass                   optional; defaults by type (Balance.Fight.MassByType)
--   Tint                   UI accent colour (hex)
--   ClinkPitch             impact sound pitch; small glassies clink higher
--   Asset                  folder under ReplicatedStorage.Assets.Glassies and assets/blender/glassies

export type GlassyDef = {
	Id: string,
	Name: string,
	Type: "Heavy" | "Sharp" | "Fizzy",
	Rarity: "Starter" | "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic",
	Base: { Power: number, HP: number, Swing: number },
	Passive: string,
	PassiveName: string?,
	Special: string,
	SpecialName: string?,
	Radius: number,
	Mass: number?,
	Tint: string,
	ClinkPitch: number,
	Asset: string,
	Description: string,
}

