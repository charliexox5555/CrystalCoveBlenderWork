--!strict
-- Every glassy in the game (GAME_DESIGN 4). Adding a glassy = one entry here + one asset folder
-- under assets/blender/glassies/<Id>/. No new code.
--
-- Base stats are before rarity, level, stars and Rainbow (see Formula.stats). Type leans:
--   Heavy  ~ Power 19, HP 118, Swing 5   (tanky)
--   Fizzy  ~ Power 20, HP 111, Swing 10  (balanced)
--   Sharp  ~ Power 22, HP 99,  Swing 16  (hits hard, crits, cracks sooner)
-- Fight strength is roughly Power x HP, so keep that product about equal across types
-- (~2,200 at base). Even fights then last 4-6 clashes and type advantage wins ~70%.
--
-- Fields:
--   Tint        UI accent colour for the glassy (hex)
--   ClinkPitch  impact sound pitch; small glassies clink higher
--   EvolvesTo   { Level, Id } for evolution lines (evolved Base stats already include x1.2)
--   WildZones   zones where it can spawn wild (spawn weights live in Zones.luau)
--   Asset       folder name under ReplicatedStorage.Assets.Glassies and assets/blender/glassies

export type GlassyDef = {
	Id: string,
	Name: string,
	Type: "Heavy" | "Sharp" | "Fizzy",
	Rarity: "Starter" | "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic",
	Base: { Power: number, HP: number, Swing: number },
	Tint: string,
	ClinkPitch: number,
	Asset: string,
	EvolvesTo: { Level: number, Id: string }?,
	WildZones: { string },
	Description: string,
}

