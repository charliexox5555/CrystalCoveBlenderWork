-- The sheet and pixel rect for an item, or nil.
function ItemIconSheets.get(category: string, id: string): (string?, Vector2?, Vector2?)
	local key = category .. "/" .. id
	for _, sheet in ItemIconSheets.Sheets do
		local index = sheet.Items[key]
		if index then
			local col, row = index % sheet.Columns, index // sheet.Columns
			return sheet.Image, Vector2.new(col * sheet.Cell, row * sheet.Cell), Vector2.new(sheet.Cell, sheet.Cell)
		end
	end
	return nil, nil, nil
end

return ItemIconSheets
