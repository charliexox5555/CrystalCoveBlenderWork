local Settings = if script
	then require(game.ReplicatedStorage.Shared.Config.Settings)
	else require("../shared/Config/Settings")
return function(t)
	t.test("settings fill in defaults and clamp bad saves", function()
		local s = Settings.normalize(nil)
		t.eq(s.Master, 1)
		t.eq(s.BotPlay, true)
		local bad =
			Settings.normalize({ Master = 5, Music = -1, SFX = 0 / 0, BotPlay = "no", AutoCast = true, Extra = 1 })
		t.eq(bad.Master, 1)
		t.eq(bad.Music, 0)
		t.eq(bad.SFX, Settings.Defaults.SFX)
		t.eq(bad.BotPlay, true)
		t.eq(bad.AutoCast, true)
		t.eq(bad.Extra, nil)
	end)
	t.test("old music prefs migrate: muted means music 0", function()
		t.eq(Settings.fromLegacyMusic({ Muted = true, Volume = 0.6 }).Music, 0)
		t.eq(Settings.fromLegacyMusic({ Muted = false, Volume = 0.6 }).Music, 0.6)
		t.eq(Settings.fromLegacyMusic(nil).Music, Settings.Defaults.Music)
	end)
	t.test("a client change accepts only known keys with the right type", function()
		local s = Settings.normalize(nil)
		t.eq(Settings.change(s, "Music", 0.333).Music, 0.33)
		t.eq(Settings.change(s, "Music", 2).Music, 1)
		t.eq(Settings.change(s, "BotPlay", false).BotPlay, false)
		t.eq(Settings.change(s, "BotPlay", 0), nil)
		t.eq(Settings.change(s, "Music", true), nil)
		t.eq(Settings.change(s, "Music", math.huge), nil)
		t.eq(Settings.change(s, "Coins", 1), nil)
		t.eq(Settings.change(s, {}, 1), nil)
		t.eq(s.BotPlay, true) -- the original is untouched
	end)
end
