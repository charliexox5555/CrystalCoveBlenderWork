-- Regenerates src/shared/Config/GlassyMotion.luau from the Blender motion manifests:
--   lune run tools/gen_glassy_motion
-- The conversion is pure (src/shared/GlassyMotionConvert.luau) and covered by src/tests/GlassyMotionTests.luau.
local fs = require("@lune/fs")
local serde = require("@lune/serde")
local process = require("@lune/process")
local Convert = require("../src/shared/GlassyMotionConvert")

local SOURCES = {
	"docs/art/glassy_revamp/motion_manifest.json",
	"docs/art/launch_glassies/motion_manifest.json",
}
local OUT = "src/shared/Config/GlassyMotion.luau"

local manifests = {}
for _, path in SOURCES do
	table.insert(manifests, serde.decode("json", fs.readFile(path)))
end
local config = Convert.config(manifests)
-- Drop parts whose `follows` parent was not kept (static parents without a pivot).
local problems = Convert.validate(config)
if #problems > 0 then
	print("GlassyMotion config problems:\n" .. table.concat(problems, "\n"))
	process.exit(1)
end
local count, parts = 0, 0
for _, g in config.Glassies do
	count += 1
	parts += #g.Parts
end
local header = table.concat({
	"-- GENERATED by tools/gen_glassy_motion.luau from " .. table.concat(SOURCES, " and ") .. ". Do not edit by hand.",
	"-- Per glassy: moving Details parts in model space (studs at GlassyScale 1, origin = hang point), parents before",
	"-- followers. Read by src/client/Presentation/GlassyMotion.luau; types in src/shared/GlassyMotionConvert.luau.",
}, "\n")
fs.writeFile(OUT, header .. "\nreturn " .. Convert.serialize(config) .. "\n")
print(string.format("wrote %s: %d glassies, %d moving parts", OUT, count, parts))
