local gates={} local report={Islands={},BridgeCenters={},SafetySegments=0}
for _,name in {"Isle_Lobby","Isle_Arena1","Isle_Arena2","Isle_Arena3","Isle_Featured"} do
 local data=Live[name] local source=prior["Fence_"..name]
 local model=source:Clone() model.Parent=visuals
 local o=Vector3.new(table.unpack(data.Position))
 local transform=CFrame.new(o)*CFrame.Angles(0,math.pi,0)*CFrame.new(-o)
 for _,p in model:GetChildren() do if p:IsA("BasePart") then p.CFrame=transform*p.CFrame p.PivotOffset=p.CFrame:ToObjectSpace(CFrame.new(o)) end end
 model.WorldPivot=CFrame.new(o)
 local north,south=name~="Isle_Featured",name~="Isle_Lobby"
 local paths,gateSection=fitted(data,north,south)
 local wall=Instance.new("Model") wall.Name,wall.Parent=name,safety
 gates[name]={}
 for _,path in paths do
  local wp={} for _,p in path do table.insert(wp,world(data,p)) end
  rails(wall,wp,true) report.SafetySegments+=#wp-1
  for _,p in {path[1],path[#path]} do if math.abs(math.abs(p.X)-5.5)<.01 then
   local side=if p.Y<0 then "North" else "South"
   gates[name][side]=gates[name][side] or {}
   gates[name][side][if p.X<0 then 1 else 2]=world(data,p)
  end end
 end
 if name=="Isle_Lobby" or name=="Isle_Featured" then
  local wantedNorth=name=="Isle_Lobby"
  local cut=Instance.new("Part") cut.Size=Vector3.new(11,12,12)
  cut.CFrame=CFrame.new(o+Vector3.new(0,3,(if wantedNorth then -1 else 1)*data.Size[2]/2))
  local clips={}
  for _,p in OriginalPosts["Fence_"..name] do
   if math.abs(p[1])<6.05 and ((p[2]<0)==wantedNorth) and math.abs(p[2])>data.Size[2]*.3 then
    local c=Instance.new("Part") c.Size=Vector3.new(1.2,12,1.2) c.CFrame=CFrame.new(o+Vector3.new(-p[1],3,p[2])) table.insert(clips,c)
   end
  end
  local old=model:GetChildren()
  for _,p in old do
   if p:IsA("MeshPart") then subtract(p,if p.Name:match("_Rails$") then {cut} else clips,model) end
  end
  cut:Destroy() for _,c in clips do c:Destroy() end
  -- Close the obsolete opposite-side gap and place posts at the real bridge opening.
  local fill=gateSection(not wantedNorth) local wp={}
  for _,p in fill do table.insert(wp,world(data,p)) end
  assert(#wp>=2,"Missing former gap path") rails(model,wp,false)
  post(model,(wp[1]+wp[#wp])/2)
  local entry=gateSection(wantedNorth) post(model,world(data,entry[1])) post(model,world(data,entry[#entry]))
 end
 model:SetAttribute("AlignmentSource","Live native grass vertices")
 report.Islands[name]={Paths=#paths,RimVertices=#data.Rim}
 task.wait()
end
local names={"Isle_Lobby","Isle_Arena1","Isle_Arena2","Isle_Arena3","Isle_Featured"}
for i=1,4 do
 local model=Instance.new("Model") model.Name,model.Parent="Fence_Bridge"..i,visuals
 local walls=Instance.new("Model") walls.Name,walls.Parent="Bridge"..i,safety
 local a,b=gates[names[i]].North,gates[names[i+1]].South
 assert(a and b and a[1] and a[2] and b[1] and b[2],"Missing bridge gates")
 for side=1,2 do
  local mid=(a[side]+b[side])/2
  mid=Vector3.new(if side==1 then -3.45 else 3.45,mid.Y,mid.Z)
  local path={a[side],mid,b[side]}
  rails(model,path,false) rails(walls,path,true) post(model,mid)
  report.SafetySegments+=2
 end
 local center=(a[1]+a[2]+b[1]+b[2])/4
 report.BridgeCenters["Bridge"..i]={center.X,center.Y,center.Z}
end
-- Swap only after all geometry is ready; no island/arena/bridge deck is moved.
local backup=Instance.new("Folder") backup.Name,backup.Parent="FenceAlignmentBefore",backupRoot
prior.Parent=backup lobby.Fences.Parent=backup
visuals.Parent=lobby safety.Parent=lobby
staging:Destroy()
game:GetService("ChangeHistoryService"):SetWaypoint("Fit fences to live irregular island meshes")
return report

