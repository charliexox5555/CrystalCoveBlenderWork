local function cross(a,b) return a.X*b.Y-a.Y*b.X end
local function pointAt(points,cum,t)
 t%=cum[#cum]
 for i,p in points do
  if t<=cum[i+1]+1e-7 then return p:Lerp(points[i%#points+1],(t-cum[i])/(cum[i+1]-cum[i])) end
 end
 return points[1]
end
local function fitted(data,north,south)
 local poly={} for _,p in data.Rim do table.insert(poly,Vector2.new(p[1],p[2])) end
 local area=0 for i,p in poly do area+=cross(p,poly[i%#poly+1]) end
 local sign=if area>0 then 1 else -1
 local rim={}
 for i,p in poly do
  local u=(p-poly[(i-2)%#poly+1]).Unit local v=(poly[i%#poly+1]-p).Unit
  local a=p+Vector2.new(-u.Y,u.X)*sign*.9
  local b=p+Vector2.new(-v.Y,v.X)*sign*.9
  table.insert(rim,if math.abs(cross(u,v))<.000001 then (a+b)/2 else a+u*(cross(b-a,v)/cross(u,v)))
 end
 local cum={0} local length=0
 for i,p in rim do length+=(rim[i%#rim+1]-p).Magnitude table.insert(cum,length) end
 local function gate(p) return math.abs(p.X)<5.5-.00001 and ((north and p.Y< -data.Size[2]*.3) or (south and p.Y>data.Size[2]*.3)) end
 local cuts={0,length}
 for i,p in rim do local q=rim[i%#rim+1]
  for _,x in {-5.5,5.5} do if math.abs(q.X-p.X)>.000001 then
   local alpha=(x-p.X)/(q.X-p.X)
   if alpha>0 and alpha<1 then local h=p:Lerp(q,alpha)
    if (north and h.Y< -data.Size[2]*.3) or (south and h.Y>data.Size[2]*.3) then table.insert(cuts,cum[i]+(q-p).Magnitude*alpha) end
   end
  end end
 end
 table.sort(cuts) local arcs={}
 for i=1,#cuts-1 do if not gate(pointAt(rim,cum,(cuts[i]+cuts[i+1])/2)) then table.insert(arcs,{cuts[i],cuts[i+1]}) end end
 if #arcs>1 and arcs[1][1]==0 and arcs[#arcs][2]==length then
  local first=table.remove(arcs,1) local last=table.remove(arcs) table.insert(arcs,{last[1],first[2]+length})
 end
 local paths={}
 for _,arc in arcs do
  local marks={arc[1],arc[2]}
  for _,c in cum do for k=0,1 do if c+k*length>arc[1]+1e-7 and c+k*length<arc[2]-1e-7 then table.insert(marks,c+k*length) end end end
  table.sort(marks) local pts={}
  for _,t in marks do local p=pointAt(rim,cum,t) if #pts==0 or (pts[#pts]-p).Magnitude>.0001 then table.insert(pts,p) end end
  table.insert(paths,pts)
 end
 local function gateSection(wantedNorth)
  local points={}
  for i,p in rim do
   local q=rim[i%#rim+1] local lo,hi=0,1
   if math.abs(q.X-p.X)>.000001 then
    local a,b=(-5.5-p.X)/(q.X-p.X),(5.5-p.X)/(q.X-p.X)
    lo,hi=math.max(0,math.min(a,b)),math.min(1,math.max(a,b))
   elseif math.abs(p.X)>5.5 then lo,hi=1,0 end
   if lo<=hi then local a,b=p:Lerp(q,lo),p:Lerp(q,hi)
    if ((a.Y+b.Y)/2<0)==wantedNorth then
     if #points==0 or (points[#points]-a).Magnitude>.00001 then table.insert(points,a) end table.insert(points,b)
    end
   end
  end
  return points
 end
 return paths,gateSection
end
local function world(data,p) return Vector3.new(data.Position[1]+p.X,data.Position[2],data.Position[3]+p.Y) end
local function part(parent,name,size,cf,color,collision)
 local p=Instance.new("Part") p.Name,p.Size,p.CFrame=name,size,cf
 p.Anchored,p.CanCollide,p.CanTouch,p.CanQuery=true,collision==true,false,collision==true
 p.Transparency=if collision then 1 else 0
 p.Color,p.Material,p.CastShadow=Color3.fromHex(color),Enum.Material.SmoothPlastic,not collision
 p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth p.Parent=parent return p
end
local function post(parent,p)
 part(parent,"GatePost",Vector3.new(.86,2.83,.86),CFrame.new(p+Vector3.yAxis*1.415),"694537")
 part(parent,"GateCap",Vector3.new(1.02,.17,1.02),CFrame.new(p+Vector3.yAxis*2.915),"B98A5C")
end
local function rails(parent,points,collision)
 for i=1,#points-1 do
  local a,b=points[i],points[i+1]
  if collision then
   part(parent,"SafetyCollider",Vector3.new(.8,3,(b-a).Magnitude),CFrame.lookAt((a+b)/2+Vector3.yAxis*1.5,b+Vector3.yAxis*1.5),"694537",true)
  else
   for _,h in {.9,2.1} do
    part(parent,"GateRail",Vector3.new(.6,.6,(b-a).Magnitude),CFrame.lookAt((a+b)/2+Vector3.yAxis*h,b+Vector3.yAxis*h),"855439")
   end
  end
 end
end
local function subtract(p,clips,parent)
 local results=game:GetService("GeometryService"):SubtractAsync(p,clips,{SplitApart=false})
 assert(#results>0,"CSG produced no fence geometry")
 for i,q in results do
  -- GeometryService bakes the input colour into vertex colours; white avoids double tint.
  q.Name=p.Name.."_GateCut"..i q.Color,q.Material=Color3.new(1,1,1),p.Material
  q:SetAttribute("BakedColor",true)
  q.Anchored,q.CanCollide,q.CanTouch,q.CanQuery=true,false,false,false
  q.Transparency,q.Reflectance=0,0 q.Parent=parent
 end
 p:Destroy() -- Only a new staging clone; both original versions remain backed up.
