-- Edit mode (Studio MCP), with the Studio lock held. Installs the v3 stained-glass leaderboards (decision 101):
-- generated by tools/studio/gen_leaderboards_v3.py from assets/blender/map/leaderboards_v3/manifest.json and
-- roblox_assets.json into install_leaderboards_v3.luau (do not edit that file by hand).
-- * First run moves the old boards (Leaderboard_Trophies/MatchWins/Shatters) into ServerStorage.LeaderboardsV2Backup
--   and records their spots. Re-runs rebuild only the v3 boards at the recorded spots.
-- * Left = old Shatters spot, Middle = old Trophies spot, Right = old MatchWins spot; each new board faces the way the
--   old display did.
-- * Builds the editable SurfaceGui templates: Screen.Display (rows; RowTemplate is cloned by LeaderboardService) and
--   TitlePlate.Header (banner title).
assert(not game:GetService("RunService"):IsRunning(), "Run in Edit")
local HttpService = game:GetService("HttpService")
local InsertService = game:GetService("InsertService")
local SS = game:GetService("ServerStorage")
local DATA = HttpService:JSONDecode([==[__DATA__]==])
local props = workspace.Lobby.GlassClashProps
local OLD = { Left = "Leaderboard_Shatters", Middle = "Leaderboard_Trophies", Right = "Leaderboard_MatchWins" }

local backup = SS:FindFirstChild("LeaderboardsV2Backup")
if not backup then
	backup = Instance.new("Folder")
	backup.Name = "LeaderboardsV2Backup"
	backup:SetAttribute("InstalledAtUTC", os.date("!%Y-%m-%dT%H:%M:%SZ"))
	for slot, name in OLD do
		local old = props:FindFirstChild(name)
		assert(old, "Missing old board " .. name)
		local cf, size = old:GetBoundingBox()
		local board = old:FindFirstChild("Board")
		local gui = board and board:FindFirstChildOfClass("SurfaceGui")
		local normal = board
				and board.CFrame:VectorToWorldSpace(Vector3.FromNormalId(gui and gui.Face or Enum.NormalId.Front))
			or cf.LookVector
		normal = Vector3.new(normal.X, 0, normal.Z).Unit
		local base = cf.Position - Vector3.new(0, size.Y / 2, 0)
		backup:SetAttribute(slot .. "Base", base)
		backup:SetAttribute(slot .. "Normal", normal)
		old.Parent = backup
	end
	backup.Parent = SS
end

local function hex(s)
	return Color3.fromHex(s)
end

local function make(class, parent, props_)
	local o = Instance.new(class)
	for k, v in props_ do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local HEADING = Font.new("rbxasset://fonts/families/DenkOne.json")
local BODY = Font.new("rbxasset://fonts/families/Nunito.json", Enum.FontWeight.Heavy)
local CAPTION = Font.new("rbxasset://fonts/families/Nunito.json", Enum.FontWeight.ExtraBold)
local LEAD, SMOKE2 = hex("1F1830"), hex("332854")

local function corner(parent, scale, offset)
	make("UICorner", parent, { CornerRadius = UDim.new(scale, offset) })
end

local function stroke(parent, color, thickness, border)
	return make("UIStroke", parent, {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = if border then Enum.ApplyStrokeMode.Border else Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

-- Rows screen: subtitle pill, ten rows (RowTemplate), empty text, footer.
local function display(part, b)
	local gui = make("SurfaceGui", part, {
		Name = "Display",
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(1100, 890),
		LightInfluence = 0,
		Brightness = 1.15,
		MaxDistance = 140,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local root = make("Frame", gui, { Name = "Root", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	local pill = make("TextLabel", root, {
		Name = "Subtitle",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(320, 54),
		BackgroundColor3 = hex(b.AccentDark),
		Text = b.Subtitle,
		FontFace = HEADING,
		TextSize = 38,
		TextColor3 = Color3.new(1, 1, 1),
	})
	corner(pill, 0.5, 0)
	stroke(pill, hex(b.AccentLight), 3, true)
	local rows = make("Frame", root, {
		Name = "Rows",
		Position = UDim2.fromOffset(30, 78),
		Size = UDim2.new(1, -60, 0, 772),
		BackgroundTransparency = 1,
	})
	rows:SetAttribute("TopHeight", 84)
	rows:SetAttribute("RowHeight", 66)
	make("UIListLayout", rows, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	local row = make("Frame", rows, {
		Name = "RowTemplate",
		Visible = false,
		LayoutOrder = 99,
		Size = UDim2.new(1, 0, 0, 66),
		BackgroundColor3 = SMOKE2,
	})
	corner(row, 0, 16)
	stroke(row, hex("57299F"), 3, true)
	make("TextLabel", row, {
		Name = "Rank",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0.5, 0),
		Size = UDim2.new(0, 70, 0.9, 0),
		BackgroundTransparency = 1,
		Text = "1",
		FontFace = HEADING,
		TextScaled = true,
		TextColor3 = hex("CDAAFF"),
	})
	local avatar = make("ImageLabel", row, {
		Name = "Avatar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 84, 0.5, 0),
		Size = UDim2.fromScale(0.84, 0.84),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundColor3 = LEAD,
		Image = "",
	})
	corner(avatar, 0.5, 0)
	stroke(avatar, Color3.new(1, 1, 1), 2, true)
	make("TextLabel", row, {
		Name = "PlayerName",
		Position = UDim2.fromOffset(160, 0),
		Size = UDim2.new(1, -480, 1, 0),
		BackgroundTransparency = 1,
		Text = "Player",
		FontFace = BODY,
		TextSize = 46,
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local group = make("Frame", row, {
		Name = "ValueGroup",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -18, 0.5, 0),
		Size = UDim2.new(0, 310, 1, 0),
		BackgroundTransparency = 1,
	})
	make("UIListLayout", group, {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	make("ImageLabel", group, {
		Name = "RobuxIcon",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(44, 44),
		BackgroundTransparency = 1,
		Image = "rbxasset://textures/ui/common/robux.png",
		ImageColor3 = Color3.new(1, 1, 1),
		Visible = b.Format == "Robux",
	})
	make("TextLabel", group, {
		Name = "Value",
		LayoutOrder = 2,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "0",
		FontFace = HEADING,
		TextSize = 52,
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	make("TextLabel", root, {
		Name = "Empty",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.86, 0, 0, 160),
		BackgroundTransparency = 1,
		Text = b.Empty,
		FontFace = BODY,
		TextSize = 64,
		TextWrapped = true,
		TextColor3 = hex("CDAAFF"),
		Visible = false,
	})
	make("TextLabel", root, {
		Name = "Footer",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(0.9, 0, 0, 36),
		BackgroundTransparency = 1,
		Text = "",
		FontFace = CAPTION,
		TextSize = 30,
		TextColor3 = hex("CDAAFF"),
	})
end

-- Banner title.
local function header(part, b)
	local gui = make("SurfaceGui", part, {
		Name = "Header",
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(900, 125),
		LightInfluence = 0,
		Brightness = 1.1,
		MaxDistance = 160,
	})
	local title = make("TextLabel", gui, {
		Name = "Title",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = b.Title,
		FontFace = HEADING,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
	})
	stroke(title, LEAD, 5, false)
	make("UIPadding", title, { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 8) })
end

local function plate(model, name, rect, s)
	-- Blender (x, y, z) -> import space (-x, z, y); the import faces -Z, so Front is the readable side.
	local c, size = rect.Center, rect.Size
	return make("Part", model, {
		Name = name,
		Size = Vector3.new(size[1], size[3], 0.05),
		CFrame = CFrame.new(-c[1], c[3], c[2] - 0.12 * s),
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		CastShadow = false,
	})
end

local report = {}
for _, b in DATA.Boards do
	local existing = props:FindFirstChild("Leaderboard_" .. b.Id)
	if existing then
		existing:Destroy()
	end
	local ok, loaded = pcall(InsertService.LoadAsset, InsertService, b.AssetId)
	assert(ok, "LoadAsset failed for " .. b.Id .. ": " .. tostring(loaded))
	local source = loaded:FindFirstChildOfClass("Model")
	local model = Instance.new("Model")
	model.Name = "Leaderboard_" .. b.Id
	for _, d in source:GetDescendants() do
		assert(not d:IsA("LuaSourceContainer"), "Unexpected script in import")
	end
	local meshes = {}
	for _, e in b.Meshes do
		local p = source:FindFirstChild(e.Name, true)
		assert(p and p:IsA("MeshPart"), "Missing mesh " .. e.Name)
		p.Color, p.Material, p.Transparency = hex(e.Color), Enum.Material[e.Material], e.Transparency
		p.Reflectance = if e.Material == "Glass" then 0.08 else 0
		p.Anchored, p.CanTouch, p.CastShadow, p.TextureID = true, false, true, ""
		local solid = e.Name:match("_Plinth$") or e.Name:match("_Towers$")
		p.CanCollide, p.CanQuery = solid ~= nil, solid ~= nil
		for _, child in p:GetChildren() do
			if child:IsA("SurfaceAppearance") then
				child:Destroy()
			end
		end
		p.Parent = model
		table.insert(meshes, p)
	end
	loaded:Destroy()
	-- The importer works in centimetres: scale about the board's origin (base centre).
	for _, p in meshes do
		p.Size /= 100
		p.Position /= 100
	end
	plate(model, "Screen", b.Screen, b.Scale)
	plate(model, "TitlePlate", b.TitleRect, b.Scale)
	display(model.Screen, b)
	header(model.TitlePlate, b)
	model:SetAttribute("LeaderboardV3", true)
	model:SetAttribute("Slot", b.Slot)
	model:SetAttribute("Stat", b.Stat)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local base, normal = backup:GetAttribute(b.Slot .. "Base"), backup:GetAttribute(b.Slot .. "Normal")
	model.WorldPivot = CFrame.identity
	model:PivotTo(CFrame.lookAt(base, base + normal))
	model.Parent = props
	table.insert(report, b.Id .. " @ " .. tostring(base))
end
return table.concat(report, "\n")
