local root, islands = workspace.Lobby.Fences, workspace.Lobby.Islands
local report = { Posts = 0, Rails = 0, Colliders = 0, OutsideGrass = {}, MinimumCentreInset = math.huge }
local function inside(p, polygon)
	local yes = false
	for i, a in polygon do
		local b = polygon[i % #polygon + 1]
		if (a.Y > p.Y) ~= (b.Y > p.Y) and p.X < (b.X - a.X) * (p.Y - a.Y) / (b.Y - a.Y) + a.X then
			yes = not yes
		end
	end
	return yes
end
for _, model in root:GetChildren() do
	local data = Paths[model.Name]
	local grass = data and islands[model.Name][model.Name .. "_Grass"]
	local polygon = {}
	if grass then
		for _, p in data.Points do
			table.insert(polygon, Vector2.new(p[1] * grass.Size.X / data.Size[1], p[2] * grass.Size.Z / data.Size[2]))
		end
	end
	for _, part in model:GetChildren() do
		assert(part:IsA("BasePart") and part.Anchored and not part.CanTouch, "Unexpected fence content")
		if part.Name == "Post" then
			report.Posts += 1
			if grass then
				local localPoint = grass.CFrame:PointToObjectSpace(part.Position)
				local p = Vector2.new(localPoint.X, localPoint.Z)
				for i, a in polygon do
					local b = polygon[i % #polygon + 1]
					local edge = b - a
					local closest = a + edge * math.clamp((p - a):Dot(edge) / edge:Dot(edge), 0, 1)
					report.MinimumCentreInset = math.min(report.MinimumCentreInset, (p - closest).Magnitude)
				end
				for _, x in { -0.5, 0.5 } do
					for _, z in { -0.5, 0.5 } do
						local corner =
							grass.CFrame:PointToObjectSpace(part.CFrame:PointToWorldSpace(Vector3.new(x, -1.5, z)))
						if not inside(Vector2.new(corner.X, corner.Z), polygon) then
							table.insert(
								report.OutsideGrass,
								{ Island = model.Name, Position = tostring(part.Position) }
							)
						end
					end
				end
			end
		elseif part.Name == "Rail" then
			report.Rails += 1
			assert(not part.CanCollide and part.Size.Z > 0, "Invalid visual rail")
		elseif part.Name == "SafetyCollider" then
			report.Colliders += 1
			assert(part.CanCollide and part.CanQuery and part.Transparency == 1, "Safety wall missing")
		end
	end
end
local params = RaycastParams.new()
params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Include, { root }
local obstruction = workspace:Raycast(Vector3.new(0, 1.5, 12), Vector3.new(0, 9, -218), params)
report.CentreLaneClear = obstruction == nil
assert(#report.OutsideGrass == 0, "Fence post corners overhang the grass")
assert(report.CentreLaneClear, "Fence obstructs the central bridge lane")
return report
